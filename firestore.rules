// firestore.rules
// Paste this in Firebase Console → Firestore → Rules tab

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── USERS ──────────────────────────────────────────────────────────────
    // Each user can only read/write their own profile document.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── WALLET ─────────────────────────────────────────────────────────────
    // Only the wallet owner can read or update their balance.
    match /wallets/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Transaction history sub-collection
      match /transactions/{txId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── BUSINESS PINS ──────────────────────────────────────────────────────
    // Anyone signed in (including guests) can read all pins.
    // Any signed-in user can add a pin.
    // Only the pin's creator can delete it.
    match /businessPins/{pinId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['name','category','lat','lon'])
        && request.resource.data.name.size() > 0;
      allow delete: if request.auth != null
        && resource.data.addedBy == request.auth.uid;
      allow update: if false; // use delete + re-add to update a pin
    }

    // ── NGANYA VOTES ───────────────────────────────────────────────────────
    // Anyone signed in can read vote counts.
    // The voters sub-collection enforces one-vote-per-user.
    match /nganyaVotes/{nganyadId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;

      match /voters/{uid} {
        allow read: if request.auth != null;
        // Can only write your OWN voter record, and only once (no update)
        allow create: if request.auth != null && request.auth.uid == uid;
        allow update, delete: if false;
      }
    }

    // ── STOP QUEUE (Lock-in) ──────────────────────────────────────────────
    // Any signed-in user can read the queue for any stop (drivers need this).
    // Users can only write/delete their own lock-in record.
    match /stopQueues/{stopId}/passengers/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
