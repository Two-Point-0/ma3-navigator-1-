# Ma3 Navigator uses Supabase as its single active backend.
# Copy this file to .env.local and replace the placeholders.
# .env.local is Git-ignored; never commit it.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
VITE_MA3_DEMO_MODE=true

# Backward-compatibility only for an older Supabase project key; do not set both.
# VITE_SUPABASE_ANON_KEY=your_legacy_anon_key

# Never put a Supabase secret/service_role key or Daraja credentials in VITE_ variables.
