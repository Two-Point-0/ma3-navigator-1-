# Ma3 unified backend — browser-safe variables only
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to GitHub — it is already in .gitignore.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_public_anon_key
VITE_MA3_DEMO_MODE=true

# Legacy Firebase variables may remain temporarily for the existing auth scaffolding.
# Never add a Firebase service-account key or Supabase service_role key here.

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id_here
