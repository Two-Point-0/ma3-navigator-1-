# Ma3 uses Supabase as its only backend.
# Copy this file to .env.local and fill in your public project values.
# NEVER put a service-role/secret key in VITE_* variables or commit .env.local.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_public_anon_key
VITE_MA3_DEMO_MODE=true
